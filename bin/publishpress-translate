#!/usr/bin/env php
<?php
/**
 * PublishPress Translation CLI
 *
 * Translates WordPress plugins using AI-powered Potomatic
 *
 * @package PublishPress\Translations
 */

use PublishPress\Translations\Output;
use PublishPress\Translations\Translator;

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

function cliError(string $message): void
{
    fwrite(STDERR, $message . "\n");
}

/**
 * Searches a list of candidate paths for the Composer autoloader and requires
 * the first one that exists. Returns true on success, false if none is found.
 *
 * @param string[] $candidatePaths
 */
function loadAutoloader(array $candidatePaths): bool
{
    foreach ($candidatePaths as $path) {
        $path = str_replace('\\', '/', $path);

        if (file_exists($path)) {
            require_once $path;
            return true;
        }
    }

    return false;
}

/**
 * Reads a .env file and exports each KEY=VALUE pair into the process
 * environment, skipping entries that are already set.
 */
function loadEnvFile(string $filePath): void
{
    $lines = file($filePath, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);

    foreach ($lines as $line) {
        $line = trim($line);

        if ($line === '' || $line[0] === '#') {
            continue;
        }

        if (strpos($line, '=') === false) {
            continue;
        }

        [$key, $value] = explode('=', $line, 2);
        $key   = trim($key);
        $value = trim($value);

        $isQuoted = strlen($value) >= 2
            && (
                ($value[0] === '"'  && $value[-1] === '"')
                || ($value[0] === "'" && $value[-1] === "'")
            );

        if ($isQuoted) {
            $value = substr($value, 1, -1);
        }

        if (getenv($key) === false) {
            putenv("{$key}={$value}");
        }
    }
}

// ---------------------------------------------------------------------------
// Bootstrap: autoloader
// ---------------------------------------------------------------------------

$autoloadCandidates = [
    __DIR__ . '/../../../../autoload.php',
    __DIR__ . '/../../../autoload.php',
    __DIR__ . '/../vendor/autoload.php',
];

$cwd = getcwd();
if ($cwd) {
    $autoloadCandidates[] = $cwd . '/vendor/autoload.php';
}

if (!loadAutoloader($autoloadCandidates)) {
    cliError("Error: Composer autoloader not found.");
    cliError("Searched in:");
    foreach ($autoloadCandidates as $path) {
        $label = file_exists($path) ? '[EXISTS]' : '[NOT FOUND]';
        cliError("  $label $path");
    }
    cliError("Please run 'composer install' first.");
    exit(1);
}

// ---------------------------------------------------------------------------
// Bootstrap: plugin root & environment
// ---------------------------------------------------------------------------

$pluginRoot = getcwd();

if (!file_exists($pluginRoot . '/composer.json')) {
    cliError("Error: composer.json not found in current directory ($pluginRoot).");
    cliError("Please run this command from your plugin's root directory.");
    exit(1);
}

$envCandidates = [
    $pluginRoot . '/.env',
    $pluginRoot . '/dev-workspace/.env',
];

foreach ($envCandidates as $envFile) {
    if (file_exists($envFile)) {
        loadEnvFile($envFile);
        break;
    }
}

$setupPotomaticPath = dirname(__DIR__) . '/scripts/setup-potomatic.php';
if (!file_exists($setupPotomaticPath)) {
    cliError("Error: Required file 'setup-potomatic.php' not found in " . dirname(__DIR__) . "/scripts/");
    exit(1);
}
require_once $setupPotomaticPath;

// ---------------------------------------------------------------------------
// CLI options
// ---------------------------------------------------------------------------

$options = getopt('', [
    'dry-run',
    'force',
    'languages:',
    'download',
    'upload',
    'repair-plurals',
    'clean-po',
    'sync-files',
    'audit',
    'audit-mode:',
    'audit-max-cost:',
    'audit-only:',
    'audit-report-format:',
    'audit-report-dir:',
    'audit-strict-po',
    'help',
]);

if (isset($options['help'])) {
    echo <<<HELP

PublishPress Translation Tool
==============================

Automatically translates WordPress plugins using AI and manages translations via Weblate.

Usage:
  publishpress-translate [options]

Options:
  --dry-run              Preview translations without making API calls
  --force                Force re-translate all strings (ignore existing)
  --languages=LANGS      Comma-separated language codes (default: all configured)
  --download             Download translations from Weblate (instead of generating)
  --upload               Upload existing translations to Weblate (no AI translation)
  --repair-plurals       Repair malformed plural entries in existing .po files
  --clean-po             Clean duplicate entries from all .po files
  --sync-files           Check status of .po and compiled formats (.mo, .json, .l10n.php)
  --audit                Audit translations (diff worthiness, empty, fuzzy, POT mismatch, header version)
  --audit-mode=MODE      interactive (default) | allow-edit | report
  --audit-max-cost=USD   Max OpenAI spend for worthiness judge (default: 5.0)
  --audit-only=LIST      Comma-separated: text,empty,fuzzy,pot,version (default: all)
  --audit-report-format=LIST  Optional. Write report files: txt (plain UTF-8, CI/logs), ansi (colors), html
                               Comma-separated; multiple files. Aliases: plain,text → txt. Default: stream only
  --audit-report-dir=DIR Optional directory for reports (default: plugin root)
  --audit-strict-po      Reserved (strict parse needs gettext v5; wp-cli uses gettext v4)
  --help                 Show this help message

Examples:
  publishpress-translate                           # Generate and upload to Weblate
  publishpress-translate --dry-run                 # Preview without API calls
  publishpress-translate --languages=de_DE,fr_FR   # Translate specific languages
  publishpress-translate --force                   # Force re-translate all
  publishpress-translate --download                # Download from Weblate
  publishpress-translate --upload                  # Upload existing translations to Weblate
  publishpress-translate --repair-plurals          # Fix malformed plural entries in .po files
  publishpress-translate --clean-po                # Remove duplicate entries from .po files
  publishpress-translate --sync-files              # Check if translated files are up-to-date
  publishpress-translate --audit                   # Run all audit checks
  publishpress-translate --audit --audit-mode=report
  publishpress-translate --audit --audit-only=text,empty --languages=de_DE
  publishpress-translate --audit --audit-report-format=txt,html --audit-report-dir=./build

Environment Variables:
  OPENAI_API_KEY               Required for AI translations (not needed for --dry-run or --download)
  WEBLATE_API_TOKEN            Required for Weblate integration (upload/download)
  TRANSLATION_OVERRIDES        Comma-separated overrides/exclusions (all languages)
                               Formats: "word" (exclude) or "word=Target" (custom form)
                               Example: "Dashboard,post type=Post Type,lightbox"
  TRANSLATION_OVERRIDES_{lang} Per-language overrides, e.g. TRANSLATION_OVERRIDES_yor
                               Example: TRANSLATION_OVERRIDES_fr_FR="lightbox=boîte lumineuse"

Workflow:
  1. Generate translations:  publishpress-translate
  2. Review in Weblate:      https://weblate.publishpress.com/
  3. Download updates:       publishpress-translate --download
  4. Build plugin with translations in /languages folder

Maintenance:
  - Clean duplicates:           publishpress-translate --clean-po
  - Fix plural formats:         publishpress-translate --repair-plurals
  - Check compilation status:   publishpress-translate --sync-files

HELP;
    exit(0);
}

// ---------------------------------------------------------------------------
// Run
// ---------------------------------------------------------------------------

try {
    $output     = new Output();
    $translator = new Translator($pluginRoot, $output);

    if (isset($options['dry-run'])) {
        $translator->setDryRun(true);
    }

    if (isset($options['force'])) {
        $translator->setForceTranslate(true);
    }

    if (isset($options['languages'])) {
        $languages = array_map('trim', explode(',', $options['languages']));
        $translator->setTargetLanguages($languages);
    }

    if (isset($options['audit-mode'])) {
        $translator->setAuditMode((string) $options['audit-mode']);
    }

    if (isset($options['audit-max-cost'])) {
        $translator->setAuditMaxCost((float) $options['audit-max-cost']);
    }

    if (isset($options['audit-only'])) {
        $only = array_map('trim', explode(',', (string) $options['audit-only']));
        $only = array_filter($only);
        $translator->setAuditOnly($only);
    }

    if (isset($options['audit-strict-po'])) {
        $translator->setAuditStrictPo(true);
    }

    if (!empty($options['audit-report-format'])) {
        $fmt = $options['audit-report-format'];
        $fmt = is_array($fmt) ? implode(',', $fmt) : (string) $fmt;
        $parts = array_map('trim', explode(',', $fmt));
        $parts = array_filter($parts);
        $translator->setAuditReportFormats($parts);
    }

    if (isset($options['audit-report-dir'])) {
        $dir = $options['audit-report-dir'];
        $dir = is_array($dir) ? end($dir) : (string) $dir;
        $translator->setAuditReportDir($dir !== '' ? $dir : null);
    }

    $modeMap = [
        'repair-plurals' => 'repairPluralEntries',
        'clean-po'       => 'cleanPoFiles',
        'sync-files'     => 'syncPoAndMoFiles',
        'download'       => 'downloadFromWeblate',
        'upload'         => 'uploadToWeblate',
        'audit'          => 'audit',
    ];

    $result = null;
    foreach ($modeMap as $flag => $method) {
        if (isset($options[$flag])) {
            $result = $translator->$method();
            break;
        }
    }

    if ($result === null) {
        $result = $translator->translate();
    }

    exit($result ? 0 : 1);
} catch (Throwable $e) {
    cliError("Error: " . $e->getMessage());
    exit(1);
}
